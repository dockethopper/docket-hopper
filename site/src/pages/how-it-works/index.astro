      bar("#c-intro", (c) => B[c].intro, fmt, "Bills introduced per Congress", css("--grey-l"));
      bar("#c-rate", (c) => B[c].law / B[c].intro, (v) => pct(v), "Share of bills that became law per Congress", css("--accent"));
    }

    // Exhibit 13: policy areas
    {
      const Pl = P.policy, W = 640, rh = 26, m = { l: 250, r: 60, t: 4 }, Hh = Pl.length * rh + m.t + 4, x = scaleLinear().domain([0, Pl[0]?.[1] || 1]).range([m.l, W - m.r]);
      const s = svg("#c-policy", W, Hh, "Laws by policy area");
      Pl.forEach(([a, v], i) => {
        const yy = m.t + i * rh;
        s.append("text").attr("x", m.l - 10).attr("y", yy + 15).attr("text-anchor", "end").attr("font-size", 13).text(a);
        s.append("rect").attr("x", m.l).attr("y", yy + 4).attr("width", x(v) - m.l).attr("height", 16).attr("fill", i === 0 ? css("--accent") : css("--grey-l"))
          .on("mousemove", (e) => showTip(e, `${a}<br><b>${fmt(v)}</b> laws · ${pct(v / A.law)}`)).on("mouseleave", hideTip);
        s.append("text").attr("x", x(v) + 6).attr("y", yy + 16).attr("font-size", 12.5).attr("font-weight", i === 0 ? 600 : 400).text(fmt(v));
      });
    }
  </script>
</Site>
