---
// How Congress works (decisions H1–H13): Part 1, the institution (seats by party, elections,
// party control); Part 2, the path of a bill (stages, gates, timing, calendar, fast lanes).
// Every number comes from how.json, written by `python -m ingest export` (ingest/howitworks.py).
import Site from "../../layouts/Site.astro";
import site from "../../data/site.json";
import how from "../../data/how.json";
import { fmt, pct, ord, fdate, word } from "../../lib/ui.js";

const base = import.meta.env.BASE_URL;
const P = how.path, A = P.all, T = how.titles, Mm = how.members, F = P.fast;
const g = (k) => Math.round(P.gaps[k]?.med ?? 0);
const yrs = `${P.years[0]} to ${P.years[1]}`;
const span = `${ord(P.first)}–${ord(P.last)} Congress`;
const dec = P.law_month[23], jan = P.law_month[24];
const cnt = (seats, p) => (seats || []).filter((s) => s[0] === p).length;
const hSeated = Mm ? Mm.house.length : 435;
const range = (xs) => (xs.length === 1 ? fmt(xs[0]) : xs.length === 2 ? `${fmt(xs[0])} and ${fmt(xs[1])}` : `${fmt(xs[0])} to ${fmt(xs[xs.length - 1])}`);
const unifiedN = T.unified_laws.length;
// H8: each stage links to the directory of the last completed Congress, filtered to that stage.
const dir = (s) => `${base}bills/${P.last}/?stage=${s}`;
const STEPS = [
  ["Introduced", "A member files the bill and it is referred to one or more committees.", 0],
  ["Committee acts", "The committee holds a markup and reports it, or the chamber discharges it.", 1],
  ["Passes its chamber", "A floor vote, or passage by suspension or unanimous consent.", 2],
  ["Passes the other chamber", "The same text must pass. Differences go back and forth or to conference.", 3],
  ["Goes to the President", "The enrolled bill is presented. The President has 10 days, Sundays excepted.", 3],
  ["Becomes law", "Signed, or law without a signature. A veto needs two-thirds of both chambers to override.", 4],
];
const TRACK2 = ["Overview", "1 Introduced", "2 Committee", "3 First chamber", "4 Second chamber", "5 President", "6 Law"];
// on: -1 = Overview, 0..5 = stages 1..6
const tr2 = (on) => ["The Congress", ...TRACK2].map((l, i) => ({ l, on: on.includes(i - 2), done: i === 0 }));
const tr1 = (k) => ["The Congress", "Chambers", "Elections", "Control", "The path of a bill"].map((l, i) => ({ l, on: i === k, done: i < k }));
const data = { P, M: Mm, C: how.control, pres: site.pres, base, last: P.last };
---
<Site title="How Congress works · Docket Hopper" section="how" nav="how" page={8}
  description={`How Congress is elected and organized, and the path a bill takes to become law, from ${fmt(A.intro)} real bills since ${P.years[0]}.`}
  note={`Bills and joint resolutions only. The path of a bill counts the ${span}, which have finished. Seats as of ${fdate(Mm?.asof)}, from the congress-legislators dataset [5].`}>

  <section class="hw-slide" id="congress">
    <div class="hw-track">{tr1(0).map((t) => <span class={t.on ? "on" : t.done ? "done" : ""}>{t.l}</span>)}</div>
    <div><div class="eyebrow">How Congress works</div>
      <h1 class="cover-t" style="max-width:24ch">Congress is 535 elected members in two chambers. A bill becomes law only when both pass the same words.</h1>
      <p class="sub">The House of Representatives has 435 voting members, each elected by one district. The Senate has 100, two from every state. Each chamber sets its own rules, and each needs more than a bare majority for some things.{Mm && ` Seats below are as of ${fdate(Mm.asof)}.`}</p></div>
    {Mm ? <>
      <div class="grid2e">
        <div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 1</span><b>House of Representatives, {hSeated} seated,</b> <span class="u">one dot per member, by party; lines mark the votes needed</span></div><div class="chart" id="c-house"></div></div>
        <div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 2</span><b>Senate, {Mm.senate.length} seated,</b> <span class="u">one dot per senator, by party; lines mark the votes needed</span></div><div class="chart" id="c-senate"></div></div>
      </div>
      <p class="sr">House: {cnt(Mm.house, "D")} Democrats, {cnt(Mm.house, "R")} Republicans, {cnt(Mm.house, "I")} independents. Senate: {cnt(Mm.senate, "D")} Democrats, {cnt(Mm.senate, "R")} Republicans, {cnt(Mm.senate, "I")} independents.</p>
      <div class="legend"><span><i class="sw" style="background:var(--dem)"></i>Democrat</span><span><i class="sw" style="background:var(--rep)"></i>Republican</span><span><i class="sw" style="background:var(--ind)"></i>Independent{cnt(Mm.senate, "I") ? " (senators caucus with Democrats)" : ""}</span></div>
    </> : <p class="note">Seat counts are not available in this build.</p>}
    <div class="hw-tiles">
      <div><div class="label">Simple majority</div><p><b>218 in the House, 51 in the Senate</b> (or 50 plus the Vice President) passes a bill under regular order, elects the Speaker and organizes committees. The majority party chairs every committee and controls what reaches the floor.</p></div>
      <div><div class="label">60 senators</div><p><b>Cloture, to end debate.</b> Any senator can hold up most bills by refusing to stop debating, the filibuster. Ending it takes 60 votes, so most Senate bills need some support from the minority party.</p></div>
      <div><div class="label">Two-thirds</div><p><b>290 in the House, 67 in the Senate</b> overrides a veto. Two-thirds of those voting also passes a House bill under suspension of the rules, the fast lane most House bills use.</p></div>
    </div>
  </section>

  <section class="hw-slide" id="elections">
    <div class="hw-track">{tr1(2).map((t) => <span class={t.on ? "on" : t.done ? "done" : ""}>{t.l}</span>)}</div>
    <div><h2 class="claim">The whole House is elected every two years. Senators serve six, a third at a time.</h2>
      <p class="sub">Each two-year term is one numbered Congress. It starts on January 3 after an election. Every bill not passed by the end of a Congress dies and has to be introduced again, which is why this site counts bills by Congress. House seats are divided among the states by population after each census.</p></div>
    <div class="grid2"><div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 3</span><b>Who is on the ballot, by election year,</b> <span class="u">each bar is one term of office; outlined terms end at the next election</span></div><div class="chart" id="c-cycle"></div></div>
      <div class="sowhat"><div class="label">So what</div>
        <p><b>The House turns over fastest.</b> All 435 seats are up every even year, so House majorities respond to the national mood within two years.</p>
        <p><b>The Senate changes slowly by design.</b> Only about 33 seats are up in any election. Senators are split into three classes, and a class serves six years.</p>
        <p id="nextel"></p></div></div>
  </section>

  <section class="hw-slide" id="control">
    <div class="hw-track">{tr1(3).map((t) => <span class={t.on ? "on" : t.done ? "done" : ""}>{t.l}</span>)}</div>
    <div><h2 class="claim">{T.control}</h2>
      <p class="sub">The majority in each chamber decides which bills get a hearing and a vote. Control has often been split since {P.years[0]}.</p></div>
    <div class="grid2"><div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 4</span><b>Seats by party at the start of each Congress, and laws enacted,</b> <span class="u">House and Senate, {ord(P.first)}–{ord(site.cur)} Congress</span></div><div class="chart" id="c-control"></div></div>
      <div class="sowhat"><div class="label">So what</div>
        {unifiedN > 0 && T.divided_laws.length > 0 && <p><b>Unified government passed more.</b> The {unifiedN === 1 ? "one completed Congress" : `${word(unifiedN)} completed Congresses`} where one party held both chambers and the presidency enacted {range(T.unified_laws)} laws; divided Congresses enacted {range(T.divided_laws)}.</p>}
        <p><b>Majorities have been thin.</b> A shift of a handful of seats can change which party sets the agenda in either chamber.</p>
        <p><b>Sponsors in the majority do better.</b> On the <a href={`${base}outcomes/`}>Outcomes page</a>, bills from majority-party sponsors become law far more often than bills from the minority.</p></div></div>
  </section>

  <section class="hw-slide" id="path">
    <div class="hw-track">{tr2([-1]).map((t) => <span class={t.on ? "on" : t.done ? "done" : ""}>{t.l}</span>)}</div>
    <div><div class="eyebrow">The path of a bill</div>
      <h2 class="cover-t" style="max-width:24ch">Of {fmt(A.intro)} bills introduced from {yrs}, <em>{fmt(A.law)}</em> became law.</h2>
      <p class="sub">The rest of this page follows the route every bill takes through Congress and counts how many made it past each stage. It uses the {ord(P.first)} to {ord(P.last)} Congress, which have finished, so every bill here has a final outcome.</p></div>
    <div class="grid2"><div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 5</span><b>Every bill introduced, by the furthest stage it reached,</b> <span class="u">one square = 50 bills, {span}</span></div>
        <div class="chart" id="c-grid"></div><div class="legend" id="lg-grid"></div></div>
      <div class="sowhat"><div class="label">So what</div>
        <p><b>{pct(P.far.intro / A.intro, 0)} of bills never left committee.</b> No committee report, no floor time. Introducing a bill is easy; a member needs only to drop it in the hopper.</p>
        <p><b>Passing one chamber is not halfway.</b> Of bills that passed their own chamber, {pct(1 - A.p2 / A.p1, 0)} died in the other one.</p>
        <p><b>The end of the route is nearly automatic.</b> Of the {fmt(A.p2)} bills that cleared both chambers, {fmt(A.law)} became law and {fmt(A.veto)} {A.veto === 1 ? "was" : "were"} vetoed.</p></div></div>
  </section>

  <section class="hw-slide" id="route">
    <div class="hw-track">{tr2([0, 1, 2, 3, 4, 5]).map((t) => <span class={t.on ? "on" : t.done ? "done" : ""}>{t.l}</span>)}</div>
    <div><h2 class="claim">Every bill follows the same six stages, and the field narrows hardest at the first gate.</h2>
      <p class="sub">House bills and Senate bills run the same route in mirror image. Band height is the number of bills still alive, drawn to one scale, so the thin blue sliver at the end is the true size of the law column.</p></div>
    <div><div class="exh-h"><span class="n">Exhibit 6</span><b>The route, with bills remaining at each stage,</b> <span class="u">by the chamber where the bill started, {span}; stage names open the {ord(P.last)} Congress's bills at that stage</span></div>
      <div class="hw-scroll"><div class="hw-steps">{STEPS.map(([t, d, s], i) => <div><span class="k">{i + 1}</span><a href={dir(s)}><b>{t}</b></a>{d}</div>)}</div>
        <div class="chart hw-wide" id="c-route"></div></div>
      <p class="note">Bills can skip a stage: {fmt(P.p1_no_committee)} bills passed a chamber with no recorded committee report or discharge, mostly Senate bills passed by unanimous consent soon after introduction. They are counted at every later stage they reached. Days below the route are the median time each leg took for the {fmt(A.law)} bills that became law.</p></div>
  </section>

  <section class="hw-slide" id="gates">
    <div class="hw-track">{tr2([1, 2, 3]).map((t) => <span class={t.on ? "on" : t.done ? "done" : ""}>{t.l}</span>)}</div>
    <h2 class="claim">{T.gates}</h2>
    <div class="grid2"><div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 7</span><b>Share of bills at each stage that reached the next one,</b> <span class="u">percent, {span}</span></div><div class="chart" id="c-gates"></div></div>
      <div class="sowhat"><div class="label">So what</div>
        <p><b>Committee chairs decide most outcomes.</b> Only {pct(A.committee / A.intro, 0)} of bills get a committee report or discharge. A chair who never schedules a markup ends a bill without a vote.</p>
        <p><b>The second chamber is the next wall.</b> Most bills that pass one chamber wait in the other until the Congress ends.</p>
        <p><b>Vetoes are rare.</b> Presidents vetoed {fmt(A.veto)} bills in these Congresses. A bill that reaches the President has usually been negotiated with the White House already.</p></div></div>
  </section>

  <section class="hw-slide" id="clock">
    <div class="hw-track">{tr2([0, 1, 2, 3, 4, 5]).map((t) => <span class={t.on ? "on" : t.done ? "done" : ""}>{t.l}</span>)}</div>
    <h2 class="claim">A typical law takes about {Math.round(g("intro_law") / 30.4)} months, and most of that time passes before the first floor vote.</h2>
    <div class="grid2"><div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 8</span><b>Days spent on each leg of the route,</b> <span class="u">median and middle half, the {fmt(A.law)} bills that became law</span></div><div class="chart" id="c-clock"></div></div>
      <div class="sowhat"><div class="label">So what</div>
        <p><b>The wait is up front.</b> The median law spent {g("intro_p1")} days between introduction and its first chamber vote, and {g("p1_p2")} more waiting on the other chamber.</p>
        <p><b>The last two steps take about two weeks.</b> Enrolling and presenting the bill takes a median {g("p2_pres")} days, and the President signs a median {g("pres_law")} days later.</p>
        <p><b>The spread is wide.</b> A quarter of laws took more than {fmt(P.gaps.intro_law.p75)} days, and some passed both chambers within a week of introduction.</p></div></div>
  </section>

  <section class="hw-slide" id="calendar">
    <div class="hw-track">{tr2([5]).map((t) => <span class={t.on ? "on" : t.done ? "done" : ""}>{t.l}</span>)}</div>
    <div><h2 class="claim">{T.calendar}</h2>
      <p class="sub">Each Congress lasts two years. Bills still pending when it ends die. The deadline pulls work to the end: the weeks after the election, the lame-duck session, are the busiest of the term.</p></div>
    <div class="grid2"><div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 9</span><b>Every law, from introduction to enactment, on one two-year calendar,</b> <span class="u">one line per law, sorted by enactment date; laws per month below</span></div><div class="chart" id="c-lines"></div></div>
      <div class="sowhat"><div class="label">So what</div>
        <p><b>{fmt(dec)} laws were enacted in the final December</b>, {pct(dec / A.law, 0)} of the total. Another {fmt(jan)} were signed in the January after, as Congress adjourned.</p>
        <p><b>Introductions run the other way.</b> Members file the most bills in the first months of a Congress, when the field is open. Each grey line starts where its bill was filed.</p>
        <p><b>The steep right edge is the deadline.</b> Bills from every month of the term converge on the same few weeks.</p></div></div>
  </section>

  <section class="hw-slide" id="fast">
    <div class="hw-track">{tr2([2, 3]).map((t) => <span class={t.on ? "on" : t.done ? "done" : ""}>{t.l}</span>)}</div>
    <div><h2 class="claim">{T.fast}</h2>
      <p class="sub">A contested bill in the House needs a rule from the Rules Committee and hours of debate. A contested bill in the Senate can face a filibuster that takes 60 votes to end. Most bills avoid both.</p></div>
    <div class="grid2"><div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 10</span><b>How bills passed the chamber where they started,</b> <span class="u">share of bills passed, {span}</span></div>
        <div class="hw-lanes">{[["House bills passed by the House", F.house_susp, F.house_p1, "under suspension of the rules"], ["Senate bills passed by the Senate", F.senate_uc, F.senate_p1, "by unanimous consent"]].map(([l, a, b, how_]) =>
          <div><div class="lab"><span><b>{l}</b>, {fmt(b)}</span><span><b class="num">{pct(a / b, 0)}</b> {how_}</span></div>
            <div class="bar" title={`${fmt(a)} ${how_}; ${fmt(b - a)} regular order`}><i style={`width:${(a / b) * 100}%;background:var(--accent)`}></i><i style="flex:1;background:var(--grey-l)"></i></div></div>)}</div>
        <div class="legend"><span><i class="sq" style="background:var(--accent)"></i>Fast lane</span><span><i class="sq" style="background:var(--grey-l)"></i>Regular order</span></div>
        <div class="hw-tiles hw-big"><div><b class="num">{fmt(F.conference)}</b>laws went through a conference committee</div><div><b class="num">{fmt(F.pingpong)}</b>settled differences by trading amendments</div><div><b class="num">{fmt(F.laws - F.conference - F.pingpong)}</b>passed both chambers in identical form</div></div></div>
      <div class="sowhat"><div class="label">So what</div>
        <p><b>House suspension</b> limits debate to 40 minutes, bars amendments, and needs a two-thirds vote. It is the default route for bills with broad support.</p>
        <p><b>Senate unanimous consent</b> passes a bill with no roll call if no senator objects. One objection sends it back to the regular process.</p>
        <p><b>Conference committees have nearly disappeared.</b> Only {fmt(F.conference)} laws went through one.</p></div></div>
  </section>

  <section class="hw-slide" id="trend">
    <div class="hw-track">{tr2([0, 5]).map((t) => <span class={t.on ? "on" : t.done ? "done" : ""}>{t.l}</span>)}</div>
    <h2 class="claim">{T.trend}</h2>
    <div class="grid2e"><div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 11</span><b>Bills introduced,</b> <span class="u">bills and joint resolutions per Congress</span></div><div class="chart" id="c-intro"></div></div>
      <div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 12</span><b>Share that became law,</b> <span class="u">percent of bills introduced per Congress</span></div><div class="chart" id="c-rate"></div></div></div>
    <p class="note">The {ord(site.cur)} Congress is still in session and is shown outlined, for context only; its bills can still move. It is left out of every exhibit in the path of a bill except these two and Exhibit 4.</p>
  </section>

  <section class="hw-slide" id="laws">
    <div class="hw-track">{tr2([5]).map((t) => <span class={t.on ? "on" : t.done ? "done" : ""}>{t.l}</span>)}</div>
    <h2 class="claim">{T.naming}</h2>
    <div class="grid2"><div style="min-width:0"><div class="exh-h"><span class="n">Exhibit 13</span><b>Laws by policy area,</b> <span class="u">top ten areas assigned by the Congressional Research Service, {span}</span></div><div class="chart" id="c-policy"></div></div>
      <div class="sowhat"><div class="label">So what</div>
        <p><b>{P.policy[0]?.[0]} leads{P.naming_in_top / P.policy[0]?.[1] >= 0.5 ? " because of naming bills" : ""}.</b> {fmt(P.naming_in_top)} of its {fmt(P.policy[0]?.[1])} laws name a building or a place. Naming a post office alone accounts for {fmt(P.post_office)} laws.</p>
        <p><b>Big policy moves in big packages.</b> Spending bills and the annual defense authorization carry the text of many smaller bills.</p>
        <p><b>A bill that died may still have become law.</b> {fmt(P.twins)} bills that never passed had an identical companion bill that did.</p></div></div>
  </section>

  <section class="hw-slide" id="glossary">
    <div><div class="eyebrow">Reference</div><h2 class="claim" style="margin-top:4px">Terms used on this site</h2></div>
    <dl class="hw-gloss">
      <div id="g-bill"><dt>Bill (H.R., S.)</dt><dd>A proposed law. H.R. starts in the House, S. in the Senate.</dd></div>
      <div id="g-joint-resolution"><dt>Joint resolution (H.J.Res., S.J.Res.)</dt><dd>Works like a bill. Used for constitutional amendments, disapproving regulations and some spending.</dd></div>
      <div id="g-referred"><dt>Referred</dt><dd>Sent to a committee for review. Nearly every bill is referred the day it is introduced.</dd></div>
      <div id="g-reported"><dt>Markup and report</dt><dd>The committee amends the bill and votes to send it to the floor with a written report.</dd></div>
      <div id="g-discharged"><dt>Discharged</dt><dd>Taken from a committee without its report, by consent or by petition.</dd></div>
      <div id="g-suspension"><dt>Suspension of the rules</dt><dd>House fast lane: 40 minutes of debate, no amendments, two-thirds needed to pass.</dd></div>
      <div id="g-unanimous-consent"><dt>Unanimous consent</dt><dd>Senate fast lane: passes with no roll call unless one senator objects.</dd></div>
      <div id="g-cloture"><dt>Cloture</dt><dd>The Senate vote to end debate. Needs 60 votes for most bills.</dd></div>
      <div id="g-conference"><dt>Conference</dt><dd>Members of both chambers write one final version. Now rare.</dd></div>
      <div id="g-enrolled"><dt>Enrolled bill</dt><dd>The final text both chambers passed, printed and signed by their leaders for the President.</dd></div>
      <div id="g-veto"><dt>Veto and override</dt><dd>The President returns the bill unsigned. Two-thirds of both chambers can make it law anyway.</dd></div>
      <div id="g-pocket-veto"><dt>Pocket veto</dt><dd>If Congress adjourns within the 10 days and the President does not sign, the bill dies.</dd></div>
    </dl>
    <div><div class="label">Method</div>
      <p class="note">Stages are read from each bill's action history [1]: committee reports and discharges, passage in each chamber, presentation to the President, and enactment. Fast lanes are House passages whose actions record a motion to suspend the rules and pass, and Senate passages recorded as by unanimous consent. Naming laws are titles that designate or name a facility, place or building, or authorize a commemorative coin. Party control uses the majority party of each chamber and the President's party; the Senate split of the {ord(117)} Congress counts the Vice President's tie-breaking vote. [5] congress-legislators, a public dataset of members of Congress maintained on GitHub.</p></div>
  </section>

  <script is:inline type="application/json" id="hw-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
  <script>
    import { scaleLinear, scaleBand } from "d3-scale";
    import { select, pointer } from "d3-selection";
    import { line as d3line } from "d3-shape";
    import { sum, max, range as d3range } from "d3-array";
    import { svg, css, showTip, hideTip, dataOf } from "../../lib/charts.js";
    import { fmt, pct, ord, billLabel } from "../../lib/ui.js";
    const { P, M, C, pres, base, last } = dataOf("hw-data");
    const A = P.all, PC = { D: "--dem", R: "--rep", I: "--ind", O: "--grey" }, PN = { D: "Democrat", R: "Republican", I: "Independent", O: "Other" };

    // Exhibits 1–2: hemicycles, seats sorted by angle so each party is one wedge
    function hemicycle(el, seats, total, thresholds, label) {
      const W = 520, R = 222, cx = W / 2, cy = R + 40, big = total > 200, rows = big ? 12 : 6, r0 = R * (big ? 0.38 : 0.42);
      const radii = d3range(rows).map((i) => r0 + ((R - r0) * i) / (rows - 1)), sumR = sum(radii);
      const per = radii.map((r) => Math.round((total * r) / sumR)); per[rows - 1] += total - sum(per);
      const pos = [];
      radii.forEach((r, i) => { const n = per[i]; for (let j = 0; j < n; j++) { const a = Math.PI - (Math.PI * j) / Math.max(1, n - 1); pos.push({ a, x: cx + r * Math.cos(a), y: cy - r * Math.sin(a) }); } });
      pos.sort((p, q) => q.a - p.a);
      const dotR = big ? 6 : 10, s = svg(el, W, cy + 34, label);
      thresholds.forEach(([k, lab]) => {
        const a = (pos[k - 1].a + pos[k].a) / 2, c = Math.cos(a), sn = Math.sin(a);
        s.append("line").attr("x1", cx + (r0 - 24) * c).attr("y1", cy - (r0 - 24) * sn).attr("x2", cx + (R + 14) * c).attr("y2", cy - (R + 14) * sn).attr("stroke", css("--ink")).attr("stroke-dasharray", "3 2");
        s.append("text").attr("class", "halo").attr("x", cx + (R + 18) * c).attr("y", cy - (R + 18) * sn).attr("text-anchor", c > 0.05 ? "start" : c < -0.05 ? "end" : "middle").attr("font-size", 12).text(lab);
      });
      s.selectAll("circle").data(pos).join("circle").attr("cx", (d) => d.x).attr("cy", (d) => d.y).attr("r", dotR)
        .attr("fill", (d, i) => (seats[i] ? css(PC[seats[i][0]]) : css("--paper"))).attr("stroke", (d, i) => (seats[i] ? css("--paper") : css("--grey"))).attr("stroke-width", 1.5)
