---
import Site from "../../../../layouts/Site.astro";
import site from "../../../../data/site.json";
import { fmt } from "../../../../lib/ui.js";
import { LEGEND } from "../../../../lib/map.js";
export function getStaticPaths() {
  return site.areas.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const base = import.meta.env.BASE_URL;
const claim = a.links
  ? `${fmt(a.n)} ${a.area.toLowerCase()} laws since 2013, joined by ${fmt(a.links)} recorded ${a.links === 1 ? "link" : "links"}`
  : `${fmt(a.n)} ${a.area.toLowerCase()} laws since 2013, none linked to another in the record`;
const meta = { url: `${base}data/net/area/${a.slug}.json`, base };
---
<Site title={`${a.area} laws · Map · Docket Hopper`} section="map" nav="map" page={4} sectionText={`Part II · Connections · ${a.area}`} description={claim}
  note="Enacted bills and joint resolutions only. A link is any relationship recorded in the bill status data [1].">
  <div><h1 class="claim" style="max-width:38ch">{claim}</h1>
    <p class="sub">Each dot is a law in this policy area, 2013 to now. Laws that stand alone drift to the edge; clusters are families of bills Congress recorded as related. <a href={`${base}map/`}>All policy areas</a>.</p></div>
  <div><div class="exh-h"><span class="n">Exhibit 1</span><b>{a.area} laws and the links between them,</b> <span class="u">one dot per law, sized by cosponsors</span></div>
    <div class="net-wrap" id="net"><div class="overlay" hidden></div></div>
    <Fragment set:html={LEGEND} />
    <div class="net-list" id="net-list"></div></div>
  <script is:inline type="application/json" id="map-meta" set:html={JSON.stringify(meta)} />
  <script>
    import { drawMap } from "../../../../lib/map.js";
    import { dataOf } from "../../../../lib/charts.js";
    const M = dataOf("map-meta");
    fetch(M.url).then((r) => r.json()).then((J) => drawMap(document.getElementById("net"), J, { base: M.base, listEl: document.getElementById("net-list") }));
  </script>
</Site>
